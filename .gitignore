# ==============================================================================
# byok-mod .gitignore
# ==============================================================================

# --- Raw device backups -------------------------------------------------
# Full firmware/NVS/filesystem dumps and any local stock-firmware archive you
# supply yourself (see LEGAL.md §3) may contain extracted secrets and are the
# offline recovery path — kept local only, never committed.
backups/

# --- Compiled/binary/archive firmware artifacts -------------------------
# Built binaries and packaged update archives should not be committed;
# firmware SOURCE trees under firmware/ are fine and are expected to add
# their own .gitignore for their own build output.
*.bin
*.hex
*.elf
*.tar
# ESP-IDF's generated per-build config — sdkconfig.defaults (tracked) is the
# source of truth; a device-generated sdkconfig should never be committed.
sdkconfig

# --- Secrets / credentials / device-extracted sensitive data -----------
# NVS partition dumps captured over serial, wherever they land.
captures/serial/*nvs*
**/nvs*
# esptool session transcripts. These echo the chip's base MAC address on every
# `Connecting...` banner (and there is one per command), so they are device-identifying
# even though they contain no credential. Added 2026-09-03 after the full-flash dump.
captures/serial/*esptool*
# Runtime capture output from scripts/usb-watch.sh. macOS ioreg dumps embed the
# logged-in account's short name, full name and console-session UUID, and the
# enumeration lines carry the device's USB MAC, so these are never committed —
# the two curated captures in captures/serial/ are the only ones tracked here.
captures/usb/
captures/web/
captures/logic/*
!captures/logic/.gitkeep
# Anything explicitly named as secret or credential.
**/*secret*
**/*credential*
# Environment files that typically hold API keys/tokens.
*.env
.env*
# Wi-Fi credentials extracted from the device or used to configure it.
wifi*.json
# Private keys / certs.
*.key
*.pem

# --- macOS ---------------------------------------------------------------
.DS_Store

# --- Python ---------------------------------------------------------------
__pycache__/
*.pyc
# pytest's cache, created in the repo root by the documented
# `pytest tests/host tests/static` invocation.
.pytest_cache/
# Glob-matched (not just the bare name) so variants like .venv-dash/ are
# caught too, not only a venv literally named .venv/.
.venv*/
venv*/
*.egg-info/

# --- Node ---------------------------------------------------------------
node_modules/

# --- Build output ---------------------------------------------------------
build/
.pio/
sdkconfig.old
*.o
# IDF component-manager downloads, reproducible from dependencies.lock
# (which stays tracked) via `idf.py reconfigure` / `idf.py build`.
firmware/s3/managed_components/
# Toolchain-install marker/cache, regenerated by the setup scripts.
firmware/.toolchain-check/
# tests/proto/Makefile's compiled binary + macOS debug-symbol bundle.
tests/proto/test_proto
tests/proto/test_proto.dSYM/
# tests/tar/Makefile mirrors tests/proto/Makefile exactly (own header
# comment) -- same rule for its compiled binary + debug-symbol bundle.
tests/tar/test_tar
tests/tar/test_tar.dSYM/
*.dSYM/

# --- Editors ---------------------------------------------------------------
.idea/
# .vscode/ is ignored wholesale (not cherry-picking settings.json to keep).
.vscode/

# --- macOS host app build artifacts ---------------------------------------
DerivedData/
.swiftpm/
xcuserdata/
.build/

# disk/flash images and dumps — never commit
*.img
*.dd
*.dmg
*.raw
*.uf2
*.nvs
.worktrees/

# --- Doom extra (extras/doom/) ---------------------------------------------
# Shareware DOOM1.WAD is freely redistributable but is still copyrighted game
# data, not project source -- fetched by extras/doom/install.sh, never
# committed. extras/doom/WAD.sha256 (the hash *record*) is tracked.
extras/doom/wad/
